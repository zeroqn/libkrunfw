From f803e07970ff014a99b9f4c6adf14b1e9dc41d08 Mon Sep 17 00:00:00 2001
From: Dorinda Bassey <dbassey@redhat.com>
Date: Tue, 8 Sep 2026 10:51:22 +0200
Subject: [PATCH 17/23] media: virtio: fix the v4l2 API for newer kernels

v4l2_fh_add()/v4l2_fh_del() take the struct file * since 7.x, and the
session helpers already carry it in session->file.
---
 drivers/media/virtio/session.h             | 4 ++--
 drivers/media/virtio/virtio_media.h        | 4 ++++
 drivers/media/virtio/virtio_media_driver.c | 2 +-
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/media/virtio/session.h b/drivers/media/virtio/session.h
index 1b3b2c279..d523c8171 100644
--- a/drivers/media/virtio/session.h
+++ b/drivers/media/virtio/session.h
@@ -119,14 +119,14 @@ static inline void
 virtio_media_session_fh_add(struct virtio_media_session *session,
 			    struct file *file)
 {
-	v4l2_fh_add(&session->fh);
+	v4l2_fh_add(&session->fh, file);
 	session->file = file;
 }
 
 static inline void
 virtio_media_session_fh_del(struct virtio_media_session *session)
 {
-	v4l2_fh_del(&session->fh);
+	v4l2_fh_del(&session->fh, session->file);
 }
 
 #endif // __VIRTIO_MEDIA_SESSION_H
diff --git a/drivers/media/virtio/virtio_media.h b/drivers/media/virtio/virtio_media.h
index 7acb2b842..b4d66ebc9 100644
--- a/drivers/media/virtio/virtio_media.h
+++ b/drivers/media/virtio/virtio_media.h
@@ -14,6 +14,10 @@
 
 #include "uapi/linux/virtio_media.h"
 
+#ifndef file_to_v4l2_fh
+#define file_to_v4l2_fh(file) ((struct v4l2_fh *)(file)->private_data)
+#endif
+
 #define DESC_CHAIN_MAX_LEN SG_MAX_SINGLE_ALLOC
 
 #define VIRTIO_MEDIA_DEFAULT_DRIVER_NAME "virtio-media"
diff --git a/drivers/media/virtio/virtio_media_driver.c b/drivers/media/virtio/virtio_media_driver.c
index 5840bb349..6ea22f879 100644
--- a/drivers/media/virtio/virtio_media_driver.c
+++ b/drivers/media/virtio/virtio_media_driver.c
@@ -54,7 +54,7 @@ virtio_media_session_alloc(struct virtio_media *vv, u32 id,
 	int i;
 	int ret;
 
-	session = kzalloc_obj(*session, GFP_KERNEL);
+	session = kzalloc(sizeof(*session), GFP_KERNEL);
 	if (!session)
 		goto err_session;
 
