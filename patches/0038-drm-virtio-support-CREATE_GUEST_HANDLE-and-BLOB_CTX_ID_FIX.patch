From 683205333cad009a2a425245659afa8a22350d96 Mon Sep 17 00:00:00 2001
From: Val Packett <val@invisiblethingslab.com>
Date: Mon, 28 Sep 2026 23:13:19 +0800
Subject: [PATCH 38/39] drm/virtio: support CREATE_GUEST_HANDLE and BLOB_CTX_ID_FIX
 re-authored on 6.12.109)

Port of Val Packett's six-commit branch valpackett/linux-qclaptops
`guest-handle` @ 3e6a365d2ac9 (2026-08-28) onto linux-6.12.109, by the cang
fork.  The feature-table, kms.c and uapi hunks are re-authored: upstream's
context carries VIRTIO_GPU_F_BLOB_ALIGNMENT = 5, which this kernel does not
(bit 5 is VIRTIO_GPU_F_FENCE_PASSING here), so upstream's bit 5 and
VIRTGPU_PARAM_BLOB_ALIGNMENT = 9 are deliberately NOT imported.

Upstream commits squashed: a412cc915ec7, 828df4d292f2, 2a41d37ca1d0,
953b78600d13, 1c148608fe3a, 3e6a365d2ac9.

---
 drivers/gpu/drm/virtio/virtgpu_drv.c   | 1 +
 drivers/gpu/drm/virtio/virtgpu_drv.h   | 1 +
 drivers/gpu/drm/virtio/virtgpu_ioctl.c | 8 +++++++-
 drivers/gpu/drm/virtio/virtgpu_kms.c   | 8 ++++++--
 include/uapi/drm/virtgpu_drm.h         | 7 ++++---
 include/uapi/linux/virtio_gpu.h        | 5 +++++
 6 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/virtio/virtgpu_drv.c b/drivers/gpu/drm/virtio/virtgpu_drv.c
index 4ec7f4ea3..f43b5e3f8 100644
--- a/drivers/gpu/drm/virtio/virtgpu_drv.c
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.c
@@ -153,6 +153,7 @@ static unsigned int features[] = {
 	VIRTIO_GPU_F_RESOURCE_BLOB,
 	VIRTIO_GPU_F_CONTEXT_INIT,
 	VIRTIO_GPU_F_FENCE_PASSING,
+	VIRTIO_GPU_F_CREATE_GUEST_HANDLE,
 };
 static struct virtio_driver virtio_gpu_driver = {
 	.feature_table = features,
diff --git a/drivers/gpu/drm/virtio/virtgpu_drv.h b/drivers/gpu/drm/virtio/virtgpu_drv.h
index 94ed0c5db..162921f82 100644
--- a/drivers/gpu/drm/virtio/virtgpu_drv.h
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h
@@ -260,6 +260,7 @@ struct virtio_gpu_device {
 	bool has_host_visible;
 	bool has_context_init;
 	bool has_fence_passing;
+	bool has_create_guest_handle;
 	struct virtio_shm_region host_visible_region;
 	struct drm_mm host_visible_mm;
 
diff --git a/drivers/gpu/drm/virtio/virtgpu_ioctl.c b/drivers/gpu/drm/virtio/virtgpu_ioctl.c
index 894f3fd14..c56edb263 100644
--- a/drivers/gpu/drm/virtio/virtgpu_ioctl.c
+++ b/drivers/gpu/drm/virtio/virtgpu_ioctl.c
@@ -36,7 +36,8 @@
 
 #define VIRTGPU_BLOB_FLAG_USE_MASK (VIRTGPU_BLOB_FLAG_USE_MAPPABLE | \
 				    VIRTGPU_BLOB_FLAG_USE_SHAREABLE | \
-				    VIRTGPU_BLOB_FLAG_USE_CROSS_DEVICE)
+				    VIRTGPU_BLOB_FLAG_USE_CROSS_DEVICE | \
+				    VIRTGPU_BLOB_FLAG_CREATE_GUEST_HANDLE)
 
 /* Must be called with &virtio_gpu_fpriv.struct_mutex held. */
 static void virtio_gpu_create_context_locked(struct virtio_gpu_device *vgdev,
@@ -453,6 +454,11 @@ static int verify_blob(struct virtio_gpu_device *vgdev,
 			return -EINVAL;
 	}
 
+	if (rc_blob->blob_flags & VIRTGPU_BLOB_FLAG_CREATE_GUEST_HANDLE) {
+		if (!vgdev->has_create_guest_handle)
+			return -EINVAL;
+	}
+
 	switch (rc_blob->blob_mem) {
 	case VIRTGPU_BLOB_MEM_GUEST:
 		*guest_blob = true;
diff --git a/drivers/gpu/drm/virtio/virtgpu_kms.c b/drivers/gpu/drm/virtio/virtgpu_kms.c
index 14e0886ca..7972a6143 100644
--- a/drivers/gpu/drm/virtio/virtgpu_kms.c
+++ b/drivers/gpu/drm/virtio/virtgpu_kms.c
@@ -202,6 +202,9 @@ int virtio_gpu_init(struct virtio_device *vdev, struct drm_device *dev)
 	if (virtio_has_feature(vgdev->vdev, VIRTIO_GPU_F_FENCE_PASSING)) {
 		vgdev->has_fence_passing = true;
 	}
+	if (virtio_has_feature(vgdev->vdev, VIRTIO_GPU_F_CREATE_GUEST_HANDLE)) {
+		vgdev->has_create_guest_handle = true;
+	}
 
 	DRM_INFO("features: %cvirgl %cedid %cresource_blob %chost_visible %cfence_passing",
 		 vgdev->has_virgl_3d    ? '+' : '-',
@@ -210,8 +213,9 @@ int virtio_gpu_init(struct virtio_device *vdev, struct drm_device *dev)
 		 vgdev->has_host_visible ? '+' : '-',
 		 vgdev->has_fence_passing ? '+' : '-');
 
-	DRM_INFO("features: %ccontext_init\n",
-		 vgdev->has_context_init ? '+' : '-');
+	DRM_INFO("features: %ccontext_init %ccreate_guest_handle\n",
+		 vgdev->has_context_init ? '+' : '-',
+		 vgdev->has_create_guest_handle ? '+' : '-');
 
 	ret = virtio_find_vqs(vgdev->vdev, 2, vqs, vqs_info, NULL);
 	if (ret) {
diff --git a/include/uapi/drm/virtgpu_drm.h b/include/uapi/drm/virtgpu_drm.h
index 2bb2d3a0c..a67869566 100644
--- a/include/uapi/drm/virtgpu_drm.h
+++ b/include/uapi/drm/virtgpu_drm.h
@@ -178,9 +178,10 @@ struct drm_virtgpu_resource_create_blob {
 #define VIRTGPU_BLOB_MEM_HOST3D            0x0002
 #define VIRTGPU_BLOB_MEM_HOST3D_GUEST      0x0003
 
-#define VIRTGPU_BLOB_FLAG_USE_MAPPABLE     0x0001
-#define VIRTGPU_BLOB_FLAG_USE_SHAREABLE    0x0002
-#define VIRTGPU_BLOB_FLAG_USE_CROSS_DEVICE 0x0004
+#define VIRTGPU_BLOB_FLAG_USE_MAPPABLE        0x0001
+#define VIRTGPU_BLOB_FLAG_USE_SHAREABLE       0x0002
+#define VIRTGPU_BLOB_FLAG_USE_CROSS_DEVICE    0x0004
+#define VIRTGPU_BLOB_FLAG_CREATE_GUEST_HANDLE 0x0008
 	/* zero is invalid blob_mem */
 	__u32 blob_mem;
 	__u32 blob_flags;
diff --git a/include/uapi/linux/virtio_gpu.h b/include/uapi/linux/virtio_gpu.h
index ceb656264..8281e2469 100644
--- a/include/uapi/linux/virtio_gpu.h
+++ b/include/uapi/linux/virtio_gpu.h
@@ -69,6 +69,11 @@
  * VIRTIO_GPU_CMD_SUBMIT_3D
  */
 #define VIRTIO_GPU_F_FENCE_PASSING       5
+/*
+ * VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB with
+ * VIRTIO_GPU_BLOB_FLAG_CREATE_GUEST_HANDLE
+ */
+#define VIRTIO_GPU_F_CREATE_GUEST_HANDLE 6
 
 enum virtio_gpu_ctrl_type {
 	VIRTIO_GPU_UNDEFINED = 0,
-- 
